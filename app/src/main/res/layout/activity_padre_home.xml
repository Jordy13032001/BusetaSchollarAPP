<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- Header: Saludo y Foto Perfil -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_yellow"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Hola, Laura!"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tus hijos registrados"
                android:textColor="#F5FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="46dp"
            android:layout_height="46dp"
            app:cardCornerRadius="23dp"
            app:cardElevation="0dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/white">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Lista de hijos del padre -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNinosPadre"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout" />

    <!-- Barra de Navegación Inferior con 5 Opciones -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/bg_bottomnav"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 1. INICIO (Activo en esta pantalla) -->
        <LinearLayout
            android:id="@+id/nav_inicio"
            style="@style/BottomNavItem">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nav_active"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="6dp">

                <ImageView
                    style="@style/BottomNavIcon"
                    android:src="@drawable/ic_nav_home"
                    app:tint="@color/school_yellow_dark" />

                <TextView
                    style="@style/BottomNavLabel"
                    android:text="Inicio"
                    android:textColor="@color/school_yellow_dark"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. RUTA -->
        <LinearLayout
            android:id="@+id/nav_ruta"
            style="@style/BottomNavItem">
            <ImageView
                style="@style/BottomNavIcon"
                android:src="@drawable/ic_nav_route"
                app:tint="@color/nav_inactive" />
            <TextView
                style="@style/BottomNavLabel"
                android:text="Ruta"
                android:textColor="@color/nav_inactive" />
        </LinearLayout>

        <!-- 3. NOTIFICACIONES -->
        <LinearLayout
            android:id="@+id/nav_notificaciones"
            style="@style/BottomNavItem">
            <ImageView
                style="@style/BottomNavIcon"
                android:src="@drawable/ic_nav_notifications"
                app:tint="@color/nav_inactive" />
            <TextView
                style="@style/BottomNavLabel"
                android:text="Notific."
                android:textColor="@color/nav_inactive" />
        </LinearLayout>

        <!-- 4. INCIDENTE -->
        <LinearLayout
            android:id="@+id/nav_incidente"
            style="@style/BottomNavItem">
            <ImageView
                style="@style/BottomNavIcon"
                android:src="@drawable/ic_nav_alert"
                app:tint="@color/alert_red" />
            <TextView
                style="@style/BottomNavLabel"
                android:text="Incidente"
                android:textColor="@color/alert_red" />
        </LinearLayout>

        <!-- 5. PERFIL -->
        <LinearLayout
            android:id="@+id/nav_perfil"
            style="@style/BottomNavItem">
            <ImageView
                style="@style/BottomNavIcon"
                android:src="@drawable/ic_nav_profile"
                app:tint="@color/nav_inactive" />
            <TextView
                style="@style/BottomNavLabel"
                android:text="Perfil"
                android:textColor="@color/nav_inactive" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
