<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_directions"
            app:tint="#FBC02D" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChoferName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Chofer"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChoferEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="correo@chofer.com"
                android:textColor="#757575"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvChoferBus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Placa: N/A | Modelo: N/A"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <!-- Ruta que definió el chofer: el padre la revisa antes de contratarlo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_nav_active"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvChoferRuta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ruta"
                    android:textColor="@color/school_yellow_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChoferSectores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Sectores"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvChoferHorario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Horario"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvChoferPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$50"
                android:textColor="#388E3C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnVerRutaMapa"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:src="@android:drawable/ic_dialog_map"
                android:background="@drawable/bg_nav_active"
                android:padding="8dp"
                android:contentDescription="Ver ruta en mapa"
                app:tint="@color/school_yellow_dark" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
